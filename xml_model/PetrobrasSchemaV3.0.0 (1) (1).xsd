				<xs:annotation>
					<xs:documentation>
						Informações do medidor de vazão sendo calibrado.
					</xs:documentation>
				</xs:annotation> 					
			</xs:element>
			<xs:element name="XML_GENERATION_INFO" type="t_dados_geracao_xml" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Informações do arquivo XML.
					</xs:documentation>
				</xs:annotation> 					
			</xs:element>
		</xs:sequence>
	</xs:complexType>



	<xs:complexType name="t_ponto_calibracao">
		<!--Definição das informações de corridas de calibração. Todos os resultados asfound e asleft serão declaradas utilizando essa estrutura.-->
		<xs:sequence>
			<xs:element name="VAZAO_CALIBRADA" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Vazão de referência para o ponto de calibração. 
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="TEMPERATURA_MEDIDOR" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Temperatura média de calibração do medidor sendo calibrado para o respectivo ponto de calibração. Deve-se calcular considerando apenas as corridas utilizadas no cálculo de repetibilidade.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="TEMPERATURA_PADRAO" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Temperatura média de calibração do medidor padrão para o respectivo ponto de calibração. Deve-se calcular considerando apenas as corridas utilizadas no cálculo de repetibilidade.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="PRESSAO_MEDIDOR" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Pressão média de calibração do medidor sendo calibrado para o respectivo ponto de calibração. Deve-se calcular considerando apenas as corridas utilizadas no cálculo de repetibilidade.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="PRESSAO_PADRAO" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Pressão média de calibração do medidor padrão para o respectivo ponto de calibração. Deve-se calcular considerando apenas as corridas utilizadas no cálculo de repetibilidade.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="VOLUME_MEDIDOR" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Volume médio de calibração do medidor sendo calibrado para o respectivo ponto de calibração. Deve-se calcular considerando apenas as corridas utilizadas no cálculo de repetibilidade.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="VOLUME_PADRAO" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Volume médio de calibração do medidor padrão para o respectivo ponto de calibração. Deve-se calcular considerando apenas as corridas utilizadas no cálculo de repetibilidade.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="REPETIBILIDADE" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Repetibilidade calculada para o ponto de calibração. Deve-se calcular a repetibilidade considerando apenas o número de corridas sucessivas solicitado pela Petrobras. 
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="DESVIO_MEDIO" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Desvio médio/erro sistemático para o respectivo ponto de calibração. Deve-se calcular considerando apenas as corridas utilizadas no cálculo de repetibilidade.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="FATOR_DO_MEDIDOR" type="t_valor_decimal_com_incert">
				<xs:annotation>
					<xs:documentation>
						Fator do medidor (Meter Factor) para o respectivo ponto de calibração. Deve-se calcular considerando apenas as corridas utilizadas no cálculo de repetibilidade.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="QUANTIDADE_DE_CORRIDAS" type="xs:nonNegativeInteger">
				<xs:annotation>
					<xs:documentation>
						Quantidade de corridas consecutivas consideradas para cálculo de repetibilidade.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_calibracao">
		<xs:sequence>
			<xs:element name="FAIXA_CALIBRADA" type="t_faixa">
				<xs:annotation>
					<xs:documentation>
						Valores mínimos e máximos de calibração do medidor.
					</xs:documentation>
				</xs:annotation> 					
			</xs:element>
			<xs:element name="FATOR_MEDIO_DO_MEDIDOR" type="t_decimal" minOccurs='0'>
				<xs:annotation>
					<xs:documentation>
						Valor Médio do Fator do medidor (Meter Factor) para toda Faixa Calibrada.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="PONTOS_DE_CALIBRACAO">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="PONTO_DE_CALIBRACAO" type = "t_ponto_calibracao" minOccurs='1' maxOccurs='unbounded'>
							<xs:annotation>
								<xs:documentation>
									Ponto de calibração do medidor em determinada vazão.
								</xs:documentation>
							</xs:annotation> 					
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_certificado_calibracao_externa_medidor_vazao">
		<!--Definição das informações associadas ao certificado de calibração de medidor de vazão em laboratório externo.-->
		<xs:complexContent>
			<xs:extension base="t_certificado">
				<xs:sequence>
					<xs:element name="FLUIDO_CALIBRACAO" type="t_fluido">
						<xs:annotation>
							<xs:documentation>
								Informações do fluido utilizado na calibração.
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
					<xs:element name="MEDIDOR_VAZAO" type="t_medidor_vazao">
						<xs:annotation>
							<xs:documentation>
								Informações do medidor de vazão sendo calibrado.
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
					<xs:element name="XML_GENERATION_INFO" type="t_dados_geracao_xml" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Informações do arquivo XML.
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	
	
	<xs:complexType name="t_ponto_curva">
		<!--Definição das informações de um ponto da curva de linearização da calibração.-->
		<xs:sequence>
			<xs:element name="VAZAO_CALIBRADA" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Vazão de referência para o ponto da curva de linearização. 
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="FREQUENCIA" type="t_valor_decimal_eng" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Frequência do sinal do medidor de vazão convertida a partir da vazão de referência do ponto da curva de linearização.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="FATOR_DO_MEDIDOR" type="t_decimal">
				<xs:annotation>
					<xs:documentation>
						Fator do medidor (Meter Factor) para o ponto da curva de linearização.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="FATOR_K_DO_MEDIDOR" type="t_valor_decimal_eng" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						K-FACTOR a ser adotado para o ponto da curva de linearização.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
		</xs:sequence>
	</xs:complexType>



	<!--Definição das informações associadas à calibração de trena. -->
	<xs:complexType name="t_ponto_calibracao_trena">
		<xs:sequence>
			<xs:element name="VALOR_REFERENCIA" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Valor de referência para o ponto de calibração. 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VALOR_INDICADO" type="t_valor_decimal_eng_com_incert">
				<xs:annotation>
					<xs:documentation>
						Valor indicado para o ponto de calibração. 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ERRO" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Erro é a diferença entre o valor indicado e o valor de referência. 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_calibracao_trena">
		<xs:sequence>
			<xs:element name="FAIXA_CALIBRADA" type="t_faixa">
				<xs:annotation>
					<xs:documentation>
						Valores mínimos e máximos de calibração da trena.
					</xs:documentation>
				</xs:annotation> 					
			</xs:element>
			<xs:element name="PONTOS_DE_CALIBRACAO">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="PONTO_DE_CALIBRACAO" type="t_ponto_calibracao_trena" minOccurs="1" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>
									Tomada de leitura da trena.
								</xs:documentation>
							</xs:annotation> 					
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="ERRO_FIDUCIAL" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Maior erro de medição do ensaio.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="INCERTEZA" type="t_valor_decimal_eng_com_k" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Maior incerteza de medição do ensaio.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_trena">
		<xs:complexContent>
			<xs:extension base="t_medidor_N4">
				<xs:sequence>
					<xs:element name="CALIBRACAO" type="t_calibracao_trena">
						<xs:annotation>
							<xs:documentation>
								Resultados de calibração.
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>



	<xs:complexType name="t_certificado_calibracao_trena">
		<!--Definição das informações associadas ao certificado de calibração de trena.-->
		<xs:complexContent>
			<xs:extension base="t_certificado">
				<xs:sequence>
					<xs:element name="TRENA" type="t_trena">
						<xs:annotation>
							<xs:documentation>
								Informações de calibração específicas de trenas.
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
					<xs:element name="XML_GENERATION_INFO" type="t_dados_geracao_xml" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Informações do arquivo XML.
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>


	

