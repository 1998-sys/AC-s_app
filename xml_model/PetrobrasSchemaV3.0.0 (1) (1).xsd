						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<!--Definição das informações associadas à geração do XML através do XML Generator.-->
	<xs:complexType name="t_dados_geracao_xml">
		<xs:sequence>
			<xs:element name="TEMPLATE_NAME" type="xs:string">
				<xs:annotation>
					<xs:documentation>
