	Dependendo da ferramenta utilizada para validar algum tipo de arquivo XML, pode ser necessário deixar apenas um elemento sem comentário.
	-->
	<xs:element name="CERTIFICADO_INSPECAO_TRECHO_RETO" type="t_certificado_dimensional_trecho"/>
	<xs:element name="CERTIFICADO_CALIBRACAO_PRESSAO" type="t_certificado_calibracao_pressao"/>
	<xs:element name="CERTIFICADO_CALIBRACAO_TEMPERATURA_TE" type="t_certificado_calibracao_temperatura_TE"/>
	<xs:element name="CERTIFICADO_CALIBRACAO_MVS" type="t_certificado_calibracao_mvs"/>
	<xs:element name="CERTIFICADO_CALIBRACAO_INLOCO_MEDIDOR_VAZAO" type="t_certificado_calibracao_inloco_medidor_vazao"/>
	<xs:element name="CERTIFICADO_INSPECAO_PLACA_ORIFICIO" type="t_certificado_dimensional_placa"/>
	<xs:element name="CERTIFICADO_CALIBRACAO_TEMPERATURA" type="t_certificado_calibracao_temperatura"/>
	<xs:element name="CERTIFICADO_CALIBRACAO_EXTERNA_MEDIDOR_VAZAO" type="t_certificado_calibracao_externa_medidor_vazao"/>
	<xs:element name="CERTIFICADO_CALIBRACAO_TRENA" type="t_certificado_calibracao_trena"/>

</xs:schema>