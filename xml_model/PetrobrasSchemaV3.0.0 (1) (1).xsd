					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CLIENTE" type="t_cliente" >
				<xs:annotation>
					<xs:documentation>
						Informações do cliente da calibração.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TECNICO_SIGNATARIO" type="t_string_nao_vazio" />
			<xs:element name="TECNICO_EXECUTANTE" type="t_string_nao_vazio" />
			<xs:element name="CONDICOES_AMBIENTAIS" type="t_condicoes_ambientais"/>
			<xs:element name="PADROES">
				<xs:complexType >
					<xs:sequence>
						<xs:element name="PADRAO" minOccurs="1" maxOccurs="unbounded" type="t_padrao"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="PROCEDIMENTO_CALIBRACAO" type="t_procedimento_calibracao" />
			<xs:element name="OBSERVACOES" type="t_observacoes"/>
		</xs:sequence>
	</xs:complexType>


