					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TEMPLATE_FILE" type="xs:string">
				<xs:annotation>
					<xs:documentation>
						Caminho do template de geração do XML.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DATA_SOURCE_FILE" type="xs:string">
				<xs:annotation>
					<xs:documentation>
						Caminho do arquivo fonte dos dados do XML.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="COMPLETENESS_INDEX" type="xs:decimal">
				<xs:annotation>
					<xs:documentation>
						Índice de completeza do XML.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GENERATOR_VERSION" type="xs:string">
				<xs:annotation>
					<xs:documentation>
						Versão do gerador do XML.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GENERATION_DATETIME" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>
						Data e hora de geração.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!--Definição de um certificado de calibração completo. O XML enviado deverá conter um elemento do tipo t_certificado.-->
	<xs:complexType name="t_certificado">
		<xs:sequence>
			<xs:element name="NUMERO_CERTIFICADO" type="t_string_nao_vazio">
