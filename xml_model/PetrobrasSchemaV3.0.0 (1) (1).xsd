<xs:schema id="CalibracaoPetrobras" targetNamespace="http://Petrobras/Medicao/Calibracao" xmlns="http://Petrobras/Medicao/Calibracao" 
		xmlns:xs="http://www.w3.org/2001/XMLSchema" >

<!-- O que mudou na Versão 3.0.0: -->
<!-- 1) Criação do novo modelo de XML de Calibração de Trena -->

<!-- Observação 1: As seguintes variáveis com ficarão mantidas como opcionais por tempo indetermindado: -->
<!-- "FATOR_MEDIO_DO_MEDIDOR" nos XMLs de calibração In Loco e Externa de Medidores de Vazão -->
<!-- "INCERTEZA", "TIPO_TRANSMISSOR_PRESSAO" e "TIPO_PRESSAO" nos  XMLs de calibração de Pressão -->

<!-- Observação 2: A Informação "EQUIPAMENTO_TIPO_MVS" passará a ser obrigatória nos XMLs de calibração de Pressão e de Temperatura a partir de 01/07/2026 -->


	<!-- Listas Globais -->
	<xs:simpleType name="t_grandeza">
		<xs:restriction base="xs:token">
			<xs:enumeration value="Adimensional" />
			<xs:enumeration value="Comprimento" />
			<xs:enumeration value="Frequência" />
			<xs:enumeration value="Massa" />
			<xs:enumeration value="Massa Específica" />
			<xs:enumeration value="Densidade" />
			<xs:enumeration value="Porcentagem" />
			<xs:enumeration value="Pressão" />
			<xs:enumeration value="Temperatura" />
			<xs:enumeration value="Tempo" />
			<xs:enumeration value="Vazão" />
			<xs:enumeration value="Velocidade" />
			<xs:enumeration value="Volume" />
			<xs:enumeration value="Área" />
			<xs:enumeration value="Ângulo" />
			<xs:enumeration value="Rugosidade" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="t_material">
		<xs:restriction base="xs:token">
			<xs:enumeration value="Aço Carbono" />
			<xs:enumeration value="Aço Galvanizado" />
			<xs:enumeration value="Aço Inox" />
			<xs:enumeration value="Aço Inox 316" />
			<xs:enumeration value="Duplex" />
			<xs:enumeration value="Monel" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="t_decimal"> 
		<xs:union> 
			<xs:simpleType> 
				<xs:restriction base="xs:decimal"/> 
			</xs:simpleType> 
			<xs:simpleType> 
				<xs:restriction base="xs:string"> 
					<xs:enumeration value="NI"/> 
				</xs:restriction> 
			</xs:simpleType> 
		</xs:union> 
	</xs:simpleType> 

	<xs:simpleType name="t_unidade">
		<xs:restriction base="xs:token">
			<xs:enumeration value="ºC" />
			<xs:enumeration value="°C" />
			<xs:enumeration value="mA" />
			<xs:enumeration value="kPa" />
			<xs:enumeration value="kgf/cm2" />
			<xs:enumeration value="kgf/cm²" />
			<xs:enumeration value="mmH2O" />
			<xs:enumeration value="%" />
			<xs:enumeration value="mm" />
			<xs:enumeration value="mm/mmºC" />
			<xs:enumeration value="mm/mm°C" />
			<xs:enumeration value="µm" />
			<xs:enumeration value="º" />
			<xs:enumeration value="°" />
			<xs:enumeration value="cP" />
			<xs:enumeration value="kg/m3" />
			<xs:enumeration value="m3/h" />
			<xs:enumeration value="m³/h" />			
			<xs:enumeration value="kg/h" />
			<xs:enumeration value="m3" />
			<xs:enumeration value="m³" />
			<xs:enumeration value="pulsos/m3" />
			<xs:enumeration value="pulsos/m³" />
			<xs:enumeration value="p/m3" />
			<xs:enumeration value="p/m³" />
			<xs:enumeration value="&quot;" />
			<xs:enumeration value="cSt" />
			<xs:enumeration value="mm2/s" />
			<xs:enumeration value="mm²/s" />
			<xs:enumeration value="Hz" />
			<xs:enumeration value="NI" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="t_estado">		
		<xs:restriction base="xs:token">
			<xs:enumeration value="Sim" />
			<xs:enumeration value="Não" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="t_aprovado">		
		<xs:restriction base="xs:token">
			<xs:enumeration value="Sim" />
			<xs:enumeration value="Não" />
			<xs:enumeration value="NI" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="t_norma">
		<xs:restriction base="xs:token">
			<xs:enumeration value="ISO 5167:1980" />
			<xs:enumeration value="ISO 5167-2:2003" />
			<xs:enumeration value="ISO 5167-2:2022" />
			<xs:enumeration value="ABNT NBR ISO 5167-2:2011" />
			<xs:enumeration value="AGA3-2:1991" />
			<xs:enumeration value="AGA3-2:2000" />
			<xs:enumeration value="AGA3-2:2016" />
			<xs:enumeration value="ISO 17089-2:2010" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="t_lista_medidor_vazao">
		<xs:restriction base="xs:token">
			<xs:enumeration value="CORIOLIS" />
			<xs:enumeration value="DESLOCAMENTO POSITIVO" />
			<xs:enumeration value="MAGNÉTICO" />
			<xs:enumeration value="TURBINA" />
			<xs:enumeration value="ULTRASSÔNICO" />
			<xs:enumeration value="V-CONE" />
			<xs:enumeration value="PROVADOR" />
		</xs:restriction>
	</xs:simpleType>


	<!--Definição das informações associadas à inspeção de trechos retos. -->
	<xs:simpleType name="t_condicionador_fluxo">
		<xs:restriction base="xs:token">
			<xs:enumeration value="19 tubos" />
			<xs:enumeration value="Zanker" />
			<xs:enumeration value="Nenhum" />
		</xs:restriction>
	</xs:simpleType>


	<xs:simpleType name="t_lista_componente">
		<xs:restriction base="xs:token">
			<xs:enumeration value="TRECHO JUSANTE" />
			<xs:enumeration value="TRECHO MONTANTE" />
			<xs:enumeration value="PORTA PLACA" />
			<xs:enumeration value="FLANGE DE ORIFICIO" />
			<xs:enumeration value="CONDICIONADOR DE FLUXO" />
			<xs:enumeration value="TRECHO RETO PARA MEDIDOR DE FLARE ULTRASSÔNICO" />

		</xs:restriction>
	</xs:simpleType>

	<!--Parâmetros de pressão. -->
	<xs:simpleType name="t_tipo_transmissor_pressao">
		<xs:restriction base="xs:token">
			<xs:enumeration value="diferencial" />
			<xs:enumeration value="estática" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="t_tipo_pressao">
		<xs:restriction base="xs:token">
			<xs:enumeration value="manométrica" />
			<xs:enumeration value="absoluta" />
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="t_valor_decimal_eng">
		<xs:simpleContent>
			<xs:extension base="t_decimal">
				<xs:attribute name="UNIDADE_ENG" type="t_unidade" use="required" />
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>


	<xs:simpleType name="t_grau_de_liberdade"> 
		<xs:union> 
			<xs:simpleType> 
				<xs:restriction base="xs:decimal"/> 
			</xs:simpleType> 
			<xs:simpleType> 
				<xs:restriction base="xs:string"> 
					<xs:enumeration value="infinito"/> 
					<xs:enumeration value="Infinito"/>
					<xs:enumeration value="INFINITO"/>
					<xs:enumeration value="NI"/> 
				</xs:restriction> 
			</xs:simpleType> 
		</xs:union> 
	</xs:simpleType> 


	<xs:complexType name="t_valor_decimal_eng_com_k">
		<xs:simpleContent>
			<xs:extension base="t_decimal">
				<xs:attribute name="UNIDADE_ENG" type="t_unidade" use="required" />
				<xs:attribute name="K" type="t_decimal" use="required"/>
				<xs:attribute name="GRAU_LIBERDADE" type="t_grau_de_liberdade" use="required"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>


	<xs:complexType name="t_valor_decimal_eng_com_incert">
		<xs:sequence>
			<xs:element name="VALOR" type="t_valor_decimal_eng" >
				<xs:annotation>
					<xs:documentation>
						Valor decimal com unidade de engenharia.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="INCERTEZA_EXP" type="t_valor_decimal_eng_com_k" >
				<xs:annotation>
					<xs:documentation>
						Valor decimal com incerteza do valor declarado.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_valor_decimal_com_incert">
		<xs:sequence>
			<xs:element name="VALOR" type="t_decimal" >
				<xs:annotation>
					<xs:documentation>
						Valor decimal sem unidade de engenharia. 
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="INCERTEZA_EXP" type="t_valor_decimal_eng_com_k" >
				<xs:annotation>
					<xs:documentation>
						Valor decimal com incerteza do valor declarado.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_valor_decimal_eng_com_variabilidade">
		<xs:sequence>
			<xs:element name="VALOR" type="t_valor_decimal_eng" >
				<xs:annotation>
					<xs:documentation>
						Valor decimal com unidade de engenharia.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="VARIABILIDADE" type="t_valor_decimal_eng" >
				<xs:annotation>
					<xs:documentation>
						Valor decimal contendo a variabilidade do valor declarado. Utilizado para condições ambientais, na qual é observada uma variabilidade durante calibrações.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_valor_decimal_eng_com_incert_opcionais_aprovado">
		<xs:sequence>
			<xs:element name="VALOR" type="t_valor_decimal_eng" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Valor decimal com unidade de engenharia.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="INCERTEZA_EXP" type="t_valor_decimal_eng_com_k" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Valor decimal com incerteza do valor declarado.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="APROVADO" type="t_aprovado">
				<xs:annotation>
					<xs:documentation>
						Indica se o valor declarado está dentro ou fora de requisitos limites.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_valor_decimal_eng_com_incert_aprovado">
		<xs:sequence>
			<xs:element name="VALOR" type="t_valor_decimal_eng" >
				<xs:annotation>
					<xs:documentation>
						Valor decimal com unidade de engenharia.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="INCERTEZA_EXP" type="t_valor_decimal_eng_com_k" >
				<xs:annotation>
					<xs:documentation>
						Valor decimal com incerteza do valor declarado.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="APROVADO" type="t_aprovado">
				<xs:annotation>
					<xs:documentation>
						Indica se o valor declarado está dentro ou fora de requisitos limites.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:simpleType name="t_string_nao_vazio">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>


	<xs:complexType name="t_empresa">
		<!--Definição das informações de cliente e laboratório-->
		<xs:sequence>
			<xs:element name="NOME" type="t_string_nao_vazio"/>
			<xs:element name="ENDERECO" type="t_string_nao_vazio" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name = "t_laboratorio">	
		<xs:complexContent>
			<xs:extension base="t_empresa">
				<xs:sequence>
					<xs:element name="ACREDITACAO" type="t_string_nao_vazio"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>


	<xs:complexType name = "t_cliente">
		<xs:complexContent>
			<xs:extension base="t_empresa">
				<xs:sequence>
					<xs:element name="UNIDADE_OPERACIONAL" type="t_string_nao_vazio">
						<xs:annotation>
							<xs:documentation>
								Instalação do cliente onde o instrumento opera.
							</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>


	<xs:complexType name="t_condicoes_ambientais">
		<!--Definição das informações ambientais do local na qual a calibração é realizada-->
		<xs:sequence>
			<xs:element name="TEMPERATURA" type="t_valor_decimal_eng_com_variabilidade" minOccurs="0"/>
			<xs:element name="PRESSAO" type="t_valor_decimal_eng_com_variabilidade" minOccurs="0"/>
			<xs:element name="UMIDADE_RELATIVA" type="t_valor_decimal_eng_com_variabilidade" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_faixa">
		<!--Definição das informações de Faixa de calibração,operação ou de medição-->
		<xs:sequence>
			<xs:element name="MIN" type="t_valor_decimal_eng"/>
			<xs:element name="MAX" type="t_valor_decimal_eng" />
			<xs:element name="RESOLUCAO" type="t_valor_decimal_eng" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Indica a resolução de leitura do instrumento calibrado.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_observacoes">
		<!--Definição genérica da estrutura utilizada para permitir que comentários sejam incorporados nas várias seções do XML -->
		<xs:sequence>
			<xs:element minOccurs="0" maxOccurs="unbounded" name="OBSERVACAO" type="t_string_nao_vazio"/>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_procedimento_calibracao">
		<!--Definição das informações do procedimento/método que foi utilizado para calibração dos instrumentos/medidores. As
		referências podem ser normas, regulamentos ou procedimentos internos.-->
		<xs:sequence>
			<xs:element name="IDENTIFICADOR" type="t_string_nao_vazio" />
			<xs:element name="DESCRICAO" type="t_string_nao_vazio" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_fluido">
		<!--Definição das informações do Fluido que foi utilizado para calibração. -->
		<xs:sequence>
			<xs:element name="DESCRICAO" type="t_string_nao_vazio" />
			<xs:element name="VISCOSIDADE" type="t_valor_decimal_eng"/>
			<xs:element name="TEMPERATURA" type="t_valor_decimal_eng"/>
			<xs:element name="PRESSAO" type="t_valor_decimal_eng"/>
			<xs:element name="MASSA_ESPECIFICA" type="t_valor_decimal_eng"/>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_padrao">
		<!--Definição das informações referentes aos padrões utilizados para calibração -->
		<xs:sequence>
			<xs:element name="DESCRICAO" type="t_string_nao_vazio" />
			<xs:element name="FABRICANTE" type="t_string_nao_vazio" minOccurs="0"/>
			<xs:element name="MODELO" type="t_string_nao_vazio" minOccurs="0"/>
			<xs:element name="IDENTIFICADOR" type="t_string_nao_vazio" />
			<xs:element name="CERTIFICADO_PADRAO">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="LABORATORIO" type="t_string_nao_vazio" />
						<xs:element name="NUMERO_CERTIFICADO" type="t_string_nao_vazio" />
						<xs:element name="DATA_CALIBRACAO" type="xs:date" minOccurs="0"/>
						<xs:element name="VALIDADE" type="xs:date" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_resultados_calibracao_medidores_vazao">
		<!--Definição das informações referentes aos padrões utilizados para calibração -->
		<xs:sequence>
			<xs:element name="DESCRICAO" type="t_string_nao_vazio" />
			<xs:element name="FABRICANTE" type="t_string_nao_vazio" minOccurs="0"/>
			<xs:element name="MODELO" type="t_string_nao_vazio" minOccurs="0"/>
			<xs:element name="NUM_SERIE" type="t_string_nao_vazio" />
			<xs:element name="CERTIFICADO_PADRAO">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="LABORATORIO" type="t_string_nao_vazio" />
						<xs:element name="NUMERO_CERTIFICADO" type="t_string_nao_vazio" />
						<xs:element name="DATA_CALIBRACAO" type="xs:date" minOccurs="0"/>
						<xs:element name="VALIDADE" type="xs:date" />
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_medidor_N1">
		<xs:sequence>
			<xs:element name="NUM_SERIE" type="t_string_nao_vazio">
				<xs:annotation>
					<xs:documentation>
						Número de série do instrumento.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="TAG" type="t_string_nao_vazio" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Tag do instrumento.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="DESCRICAO" type="t_string_nao_vazio" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Descrição do instrumento.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
		</xs:sequence>
	</xs:complexType>


	<xs:complexType name="t_medidor_N2">
		<xs:complexContent>
			<xs:extension base="t_medidor_N1">
				<xs:sequence>
					<xs:element name="FABRICANTE" type="t_string_nao_vazio">
						<xs:annotation>
							<xs:documentation>
								Fabricante do instrumento.
							</xs:documentation>
						</xs:annotation> 
					</xs:element>
					<xs:element name="MODELO" type="t_string_nao_vazio">
						<xs:annotation>
							<xs:documentation>
								Modelo do instrumento.
							</xs:documentation>
						</xs:annotation> 
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>


	<xs:complexType name="t_medidor_N3">
		<xs:complexContent>
			<xs:extension base="t_medidor_N2">
				<xs:sequence>
					<xs:element name="FAIXA_NOMINAL" type="t_faixa">
						<xs:annotation>
							<xs:documentation>
								Faixa nominal do instrumento.
							</xs:documentation>
						</xs:annotation> 
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>


	<xs:complexType name="t_medidor_N4_inLoco">
		<xs:complexContent>
			<xs:extension base="t_medidor_N3">
				<xs:sequence>
					<xs:element name="DATA_CALIBRACAO" type="xs:date" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Data de calibração do medidor
							</xs:documentation>
						</xs:annotation> 
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>



	<xs:complexType name="t_medidor_N4">
		<xs:complexContent>
			<xs:extension base="t_medidor_N3">
				<xs:sequence>
					<xs:element name="DATA_CALIBRACAO" type="xs:date">
						<xs:annotation>
							<xs:documentation>
								Data de calibração do medidor
							</xs:documentation>
						</xs:annotation> 
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="t_medidor_pressao">
		<xs:complexContent>
			<xs:extension base="t_medidor_N4">
				<xs:sequence>
					<xs:element name="TIPO_TRANSMISSOR_PRESSAO" type="t_tipo_transmissor_pressao" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Indica aplicação do transmissor de pressão no processo (diferencial / estática).
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
					<xs:element name="TIPO_PRESSAO" type="t_tipo_pressao" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Indica tipo de pressão que medida pelo instrumento (absoluta / manométrica).
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
					<xs:element name="EQUIPAMENTO_TIPO_MVS" type="t_estado" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Indica se o equipamento calibrado é do tipo MVS (Sim / Não).
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
					<xs:element name="CALIBRACAO_AS_FOUND" type="t_calibracao_pressao">
						<xs:annotation>
							<xs:documentation>
								Resultados de calibração as found.
							</xs:documentation>
						</xs:annotation> 					
					</xs:element>
					<xs:element name="CALIBRACAO_AS_LEFT" type="t_calibracao_pressao" minOccurs="0">
						<xs:annotation>
							<xs:documentation>
								Resultados de calibração as left.
