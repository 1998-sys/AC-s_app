	<!--Definição das informações associadas à inspeção de placas de orifício. -->
	<xs:complexType name="t_placa">
		<!-- Para os campos "aprovado", o valor 0 significa não, e 1 significa sim. -->
		<xs:sequence>
			<xs:element name="DATA_INSPECAO" type="xs:date" >
				<xs:annotation>
					<xs:documentation>
						Data de inspeção do trecho reto.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="NUM_SERIE" type="t_string_nao_vazio" >
				<xs:annotation>
					<xs:documentation>
						Número de série da placa de orifício.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="TAG" type="t_string_nao_vazio" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Tag da placa de orifício.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="MATERIAL" type="t_material" >
				<xs:annotation>
					<xs:documentation>
						Material da placa de orifício.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="COEF_DILATACAO" type="t_valor_decimal_eng">
				<xs:annotation>
					<xs:documentation>
						Coeficiente de dilatação da placa de orifício.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="NORMA_AVALIACAO" type="t_norma" >
				<xs:annotation>
					<xs:documentation>
						Norma de inspeção da placa de orifício.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="DIAMETRO_TUBULACAO" type="t_valor_decimal_eng"> <!-- D - Diâmetro interno a 20ºC da tubulação na qual a placa será instalada Deve ser avaliado conforme item 5.3.1 da ISO-516-->
				<xs:annotation>
					<xs:documentation>
						Diâmetro do orifício conforme itens 5.1.8 e 5.3.1 da ISO 5167.
					</xs:documentation>
				</xs:annotation>	
			</xs:element>
			<xs:element name="DIAMETRO_ORIF_COND_REF" type="t_valor_med_e_individuais"> <!-- Valor do diâmetro interno d da placa de orifício. Deve ser avaliado conforme itens 5.1.8 e 5.3.1 ISO-5167 -->
				<xs:annotation>
					<xs:documentation>
						Diâmetro do orifício conforme itens 5.1.8 e 5.3.1 da ISO 5167.
					</xs:documentation>
				</xs:annotation>	
			</xs:element>			
			<xs:element name="BETA" type="xs:decimal"> <!-- Beta da placa de orifício. Deve ser avaliado conforme item 5.3.1 ISO-5167 -->
				<xs:annotation>
					<xs:documentation>
						Beta do orifício conforme item 5.3.1 da ISO 5167.
					</xs:documentation>
				</xs:annotation>	
			</xs:element>			
			<xs:element name="CIRCULARIDADE_ORIF" type="t_valor_decimal_eng_com_incert_aprovado"> <!-- Valor da circularidade do orifício d. Deve ser avaliado conforme item 5.1.8.3 da ISO-5167-->
				<xs:annotation>
					<xs:documentation>
						Circularidade do orifício conforme item 5.1.8.3 da ISO 5167.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ESPESSURA_ORIFICIO" type="t_valor_med_e_individuais"> <!-- Espessura e do orifício. Deve ser avaliado conforme itens 5.1.5.1 e 5.1.8.3 da ISO-5167 -->
				<xs:annotation>
					<xs:documentation>
						Comprimento furo conforme itens 5.1.5.1 e 5.1.8.3 da ISO 5167.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="ESPESSURA_PLACA" type="t_valor_med_e_individuais"> <!-- Espessura E da placa. Deve ser avaliado conforme itens 5.1.5.2 e 5.1.8.4 da ISO-5167 -->
				<xs:annotation>
					<xs:documentation>
						Espessura da placa conforme itens 5.1.5.2 e 5.1.8.4 da ISO 5167.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="RUGOSIDADE_MONTANTE" type="t_valor_decimal_eng_com_incert_aprovado"> <!-- Rugosidade a montante da placa. Deve ser avaliada conforme item 5.1.3.2 da ISO 5167 e item 4.2 da AGA3-2-->
				<xs:annotation>
					<xs:documentation>
						Rugosidade a montante conforme item 5.1.3.2 da ISO 5167 e item 4.2 da AGA3-2.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="RUGOSIDADE_JUSANTE" type="t_valor_decimal_eng_com_incert_aprovado" minOccurs="0"> <!-- Rugosidade a jusante da placa. Deve ser avaliada conforme item 4.2 da AGA3-2 -->
				<xs:annotation>
					<xs:documentation>
						Rugosidade a jusante conforme item 4.2 da AGA3-2.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>	
			<xs:element name="PLANEZA_MONTANTE" type="t_valor_decimal_eng_com_incert_aprovado"> <!--Deve ser avaliada conforme item 5.1.3.2 da ISO 5167-->
				<xs:annotation>
					<xs:documentation>
						Planeza da placa conforme item 5.1.3.2 ISO 5167.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="ANGULO_DE_CHANFRO" type="t_valor_decimal_eng_com_incert_aprovado"> <!-- Deve ser avaliada conforme item 5.1.6.2 da ISO 5167 -->
				<xs:annotation>
					<xs:documentation>
						Ângulo de chanfro conforme item 5.1.6.2 da ISO 5167.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ANGULO_BORDA_G" type="t_valor_decimal_eng_com_incert_aprovado"> <!-- ºG Deve ser avaliada conforme item 5.1.7.3 da ISO 5167-->
				<xs:annotation>
					<xs:documentation>
						Ângulo de borda G conforme item 5.1.7.3 da ISO 5167.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="RAIO_BORDA_G" type="t_valor_decimal_eng_com_incert_aprovado" minOccurs="0"> <!-- Somente deve ser medida caso o diâmetro do orifício for inferior a 25mm, conforme item 5.1.7.2 da ISO 5167-->
				<xs:annotation>
					<xs:documentation>
						Raio medido da Borda G conforme item 5.1.7.2 da ISO 5167, caso o diâmetro do orifício seja menor que 25mm.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="EXCENTRICIDADE" type="t_valor_decimal_eng_com_incert_aprovado" minOccurs="0"> <!-- Deve ser avaliada conforme item 5.1.2.1 da ISO 5167 -->
				<xs:annotation>
					<xs:documentation>
						Excentricidade conforme iten 5.1.2.1 da ISO 5167.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="BORDA_G_SEM_DANOS" type="t_aprovado"> <!-- Deve ser avaliada conforme item 5.1.7.1 da ISO 5167-->
				<xs:annotation>
					<xs:documentation>
						Borda G sem danos conforme item 5.1.7.1 da ISO 5167.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
			<xs:element name="BORDA_G_AFIADA" type="t_aprovado"> <!-- Deve ser avaliada conforme item 5.1.7.2 da ISO 5167-->
				<xs:annotation>
					<xs:documentation>
						Borda G afiada conforme item 5.1.7.2 da ISO 5167.
					</xs:documentation>
				</xs:annotation> 
			</xs:element>
		</xs:sequence>
	</xs:complexType>


